<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RaizBarApp.Views.Shared.AppHeader"
             HeightRequest="60">
  <Grid BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
    <Image Source="logo.svg"
           HeightRequest="40"
           WidthRequest="40"
           Aspect="AspectFit"
           HorizontalOptions="Center"
           VerticalOptions="Center" />
  </Grid>
</ContentView>