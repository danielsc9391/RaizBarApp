<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:RaizBarApp.PageModels"
             xmlns:models="clr-namespace:RaizBarApp.Models"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:shared="clr-namespace:RaizBarApp.Views.Shared"
             x:Class="RaizBarApp.Pages.PedidoPage"
             x:DataType="pageModels:PedidoViewModel"
             x:Name="OverviewPage">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference OverviewPage}, x:DataType=ContentPage}"
                EventName="NavigatedTo"
                Command="{Binding NavigatedToCommand}" />
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference OverviewPage}, x:DataType=ContentPage}"
                EventName="NavigatedFrom"
                Command="{Binding NavigatedFromCommand}" />
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference OverviewPage}, x:DataType=ContentPage}"
                EventName="Appearing"
                Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">
        <shared:AppHeader Grid.Row="0" />
        <ScrollView Grid.Row="1">
                <Grid Padding="{StaticResource LayoutPadding}" RowSpacing="{StaticResource LayoutSpacing}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Text="Pedido de Bebidas" Style="{StaticResource Title2}" SemanticProperties.HeadingLevel="Level1"/>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding Bebidas}"
                                Margin="-7.5,0"
                                MinimumHeightRequest="250"
                                x:Name="BebidasCollectionView"
                                SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Bebida">
                                <Frame Padding="10" Margin="5" CornerRadius="5" HasShadow="True" BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding Nome}" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                        <Label Grid.Column="1" Text="{Binding Preco, StringFormat='{}{0:C}'}" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                        <Button Grid.Column="2" Text="-" WidthRequest="40" HeightRequest="40" Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:PedidoViewModel}}, Path=RemoverQuantidadeCommand}" CommandParameter="{Binding .}" />
                                        <StackLayout Grid.Column="3" Orientation="Horizontal" Spacing="5">
                                            <Label Text="{Binding Quantidade}" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="30" HorizontalTextAlignment="Center" />
                                            <Button Text="+" WidthRequest="40" HeightRequest="40" Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:PedidoViewModel}}, Path=AdicionarQuantidadeCommand}" CommandParameter="{Binding .}" />
                                        </StackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Grid Grid.Row="2" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}" Margin="5,0">
                        <Label Text="{Binding Total, StringFormat='Total: {}{0:C}'}" VerticalOptions="Center" HorizontalOptions="Center" Style="{StaticResource Title3}" TextColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
                    </Grid>
                    <Button Grid.Row="3" Text="Fechar Pedido" ImageSource="checkmark.svg" Command="{Binding FecharPedidoCommand}" Style="{StaticResource ActionConfirmButtonStyle}" Margin="10,0" />
                    <Button Grid.Row="4" Text="Limpar Pedido" ImageSource="delete.svg" Command="{Binding LimparPedidoCommand}" Style="{StaticResource ActionDangerButtonStyle}" Margin="10,0" />
                </Grid>
        </ScrollView>

    </Grid>
</ContentPage>