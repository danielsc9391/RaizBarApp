<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:RaizBarApp.PageModels"
             xmlns:models="clr-namespace:RaizBarApp.Models"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:shared="clr-namespace:RaizBarApp.Views.Shared"
             x:Class="RaizBarApp.Pages.PedidoPage"
             x:DataType="pageModels:PedidoViewModel"
             x:Name="OverviewPage">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference OverviewPage}, x:DataType=ContentPage}"
                EventName="NavigatedTo"
                Command="{Binding NavigatedToCommand}" />
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference OverviewPage}, x:DataType=ContentPage}"
                EventName="NavigatedFrom"
                Command="{Binding NavigatedFromCommand}" />
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference OverviewPage}, x:DataType=ContentPage}"
                EventName="Appearing"
                Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">
        <shared:AppHeader Grid.Row="0" Margin="0,0,0,8" ShowHamburger="True" />
        <Grid Grid.Row="1" Padding="{StaticResource LayoutPadding}" RowSpacing="{StaticResource LayoutSpacing}" RowDefinitions="Auto,*,Auto">
            <Label Grid.Row="0" Text="Pedido de Bebidas" Style="{StaticResource Title2}" SemanticProperties.HeadingLevel="Level1" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding BebidasAgrupadas}" IsGrouped="True"
                            x:Name="BebidasCollectionView"
                            SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <Label Text="Ainda não tens bebidas registadas. Vai a 'Gerir Bebidas' para adicionar." HorizontalTextAlignment="Center" />
                        <Button Text="Gerir Bebidas" Command="{Binding AbrirGestaoBebidasCommand}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Border Padding="8,5" BackgroundColor="{AppThemeBinding Light={StaticResource TagBackgroundLight}, Dark={StaticResource TagBackgroundDark}}">
                            <Label Text="{Binding Nome}" Style="{StaticResource Title4}"
                                   TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Bebida">
                                <Frame Padding="10" Margin="5" CornerRadius="5" HasShadow="True" BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding Nome}" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                        <Label Grid.Column="1" Text="{Binding Preco, StringFormat='{}{0:C}'}" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                        <Button Grid.Column="2" Text="-" WidthRequest="40" HeightRequest="40" Command="{Binding Source={x:Reference OverviewPage}, Path=BindingContext.RemoverQuantidadeCommand}" CommandParameter="{Binding .}" />
                                        <StackLayout Grid.Column="3" Orientation="Horizontal" Spacing="5">
                                            <Label Text="{Binding Quantidade}" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="30" HorizontalTextAlignment="Center" />
                                            <Button Text="+" WidthRequest="40" HeightRequest="40" Command="{Binding Source={x:Reference OverviewPage}, Path=BindingContext.AdicionarQuantidadeCommand}" CommandParameter="{Binding .}" />
                                        </StackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
            </CollectionView>
            <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource LayoutSpacing}">
                <Grid Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}">
                    <Label Text="{Binding TotalFormatado, StringFormat='Total: {0}'}" VerticalOptions="Center" HorizontalOptions="Center" Style="{StaticResource Title3}" TextColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
                </Grid>
                <Button Text="Fechar Pedido" ImageSource="checkmark.svg" Command="{Binding FecharPedidoCommand}" Style="{StaticResource ActionConfirmButtonStyle}" />
                <Button Text="Limpar Pedido" ImageSource="delete.svg" Command="{Binding LimparPedidoCommand}" Style="{StaticResource ActionDangerButtonStyle}" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>