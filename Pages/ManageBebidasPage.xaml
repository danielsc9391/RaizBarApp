<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:RaizBarApp.PageModels"
             xmlns:models="clr-namespace:RaizBarApp.Models"
             xmlns:shared="clr-namespace:RaizBarApp.Views.Shared"
             x:Class="RaizBarApp.Pages.ManageBebidasPage"
             x:Name="ManageBebidasRoot"
             x:DataType="pageModels:ManageBebidasPageModel">

    <Grid RowDefinitions="Auto,*">
        <shared:AppHeader Grid.Row="0" Margin="0,0,0,8" ShowHamburger="True" />
        <Grid Grid.Row="1" Padding="{StaticResource LayoutPadding}" RowSpacing="{StaticResource LayoutSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource TagBackgroundLight}, Dark={StaticResource TagBackgroundDark}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Gerir bebidas" Style="{StaticResource Title2}" SemanticProperties.HeadingLevel="Level1" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                        <Entry Placeholder="Nome da bebida" Text="{Binding NovaBebidaNome}" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                        <Label Text="{Binding ErroNome}" TextColor="#C85C5C" IsVisible="{Binding TemErroNome}" />
                         <Picker Title="Categoria" ItemsSource="{Binding CategoriasDisponiveis}" SelectedItem="{Binding NovaBebidaCategoria}" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                        <Border Padding="0" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource TagBackgroundLight}, Dark={StaticResource TagBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" HorizontalOptions="FillAndExpand">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="0">
                                <Entry Grid.Column="0" x:Name="PrecoEntry" Placeholder="Preço" Keyboard="Numeric" Text="{Binding NovaBebidaPreco}" TextChanged="PrecoEntry_TextChanged" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                <Label Grid.Column="1" Text="€" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" Padding="0,0,12,0" />
                            </Grid>
                        </Border>
                        <Label Text="{Binding ErroPreco}" TextColor="#C85C5C" IsVisible="{Binding TemErroPreco}" />
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                            <Button Text="{Binding TextoFormulario}" Command="{Binding AddBebidaCommand}" Style="{StaticResource ActionConfirmButtonStyle}" HorizontalOptions="End" WidthRequest="120" />
                            <Button Text="Cancelar" Command="{Binding CancelarEdicaoCommand}" IsVisible="{Binding EstaAEditar}" Style="{StaticResource ActionDangerButtonStyle}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Bebidas}"
                            Margin="-7.5,0"
                            MinimumHeightRequest="250"
                            x:Name="BebidasCollectionView"
                            SelectionMode="None">
                            <CollectionView.EmptyView>
                            <Label Text="Ainda não existem bebidas adicionadas."
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Bebida">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="🗑 Eliminar" BackgroundColor="#C85C5C" Command="{Binding Source={x:Reference ManageBebidasRoot}, Path=BindingContext.RemoveBebidaCommand}" CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                            <Frame Padding="12" Margin="5" CornerRadius="5" HasShadow="True" BackgroundColor="{AppThemeBinding Light={StaticResource TagBackgroundLight}, Dark={StaticResource TagBackgroundDark}}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Nome}" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Label Grid.Column="1" Text="{Binding Preco, StringFormat='{}{0:C}'}" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                        <Border Style="{StaticResource EditButtonStyle}"
                                                AutomationProperties.Name="Editar bebida">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference ManageBebidasRoot}, Path=BindingContext.EditBebidaCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                              <Image Source="{StaticResource IconEdit}" WidthRequest="22" HeightRequest="22"
                                                  HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit" />
                                        </Border>
                                        <Border WidthRequest="48" HeightRequest="48" Padding="0"
                                                HorizontalOptions="Center" VerticalOptions="Center"
                                                BackgroundColor="#C85C5C" StrokeThickness="0"
                                                AutomationProperties.Name="Eliminar bebida">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="24" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference ManageBebidasRoot}, Path=BindingContext.RemoveBebidaCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image Source="{StaticResource IconDeleteDanger}" WidthRequest="24" HeightRequest="24"
                                                   HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

        </Grid>
    </Grid>
</ContentPage>